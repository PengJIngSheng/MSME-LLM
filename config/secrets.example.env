# Copy this file to config/secrets.<APP_PROFILE>.env and fill in real values.
# Do not commit the copied file.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
MONGO_URI=mongodb://localhost:27017/
PGVECTOR_CONNECTION_URI=postgresql+psycopg://user:password@localhost:5432/database
SMTP_USERNAME=
SMTP_APP_PASSWORD=
GOOGLE_OAUTH_CLIENT_SECRET=
